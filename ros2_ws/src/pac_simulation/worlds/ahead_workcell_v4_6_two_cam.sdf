      <joint name="scale_loadcell_joint" type="fixed">
        <parent>conveyor_link</parent>
        <child>weigh_platform_link</child>
        <sensor name="scale_force_torque" type="force_torque">
          <always_on>true</always_on>
          <update_rate>100</update_rate>
          <topic>/pac/scale/wrench</topic>
          <force_torque>
