    <parent link="suction_cup_link"/>
    <child link="suction_tcp"/>
    <origin rpy="0 0 0" xyz="0.06 0 0"/>
  </joint>
  <!-- Gripper (wrist) camera beside the suction cup, looking along the tool direction (+x).
       Used for close-range pose refinement just before the pick; the fixed pole CCTV
       (camera_1_cctv_base in the world) gives the coarse pose. Camera type and model are undecided (simulated as RGB).
       Kept as its own link (no lumping) so the sensor frame stays at the camera. -->
  <link name="wrist_camera_link">
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/>
    </inertial>
    <visual name="wrist_camera_visual">
      <geometry>
        <box size="0.03 0.05 0.04"/>
      </geometry>
      <material name="wrist_camera_black">
        <color rgba="0.08 0.08 0.1 1"/>
      </material>
    </visual>
  </link>
  <joint name="wrist_camera_joint" type="fixed">
    <parent link="suction_cup_link"/>
    <child link="wrist_camera_link"/>
    <origin rpy="0 0 0" xyz="0.03 0.09 0"/>
  </joint>
  <gazebo reference="wrist_camera_joint">
    <preserveFixedJoint>true</preserveFixedJoint>
  </gazebo>
  <gazebo reference="wrist_camera_link">
    <sensor name="wrist_camera" type="camera">
      <always_on>true</always_on>
      <update_rate>15</update_rate>
      <topic>/pac/wrist_camera/image</topic>
      <camera>
        <horizontal_fov>1.30</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>3.0</far>
        </clip>
      </camera>
    </sensor>
  </gazebo>
  <!-- Keep the cup as its own link (no fixed-joint lumping into flange_link)
       so the contact sensor and DetachableJoint can reference it. -->
  <gazebo reference="suction_cup_joint">
    <preserveFixedJoint>true</preserveFixedJoint>
  </gazebo>
  <gazebo reference="suction_cup_link">
    <sensor name="suction_contact" type="contact">
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <contact>
        <!-- Name generated by sdformat's URDF conversion for suction_cup_collision. -->
        <collision>suction_cup_link_fixed_joint_lump__suction_cup_collision_collision</collision>
      </contact>
    </sensor>
  </gazebo>
  <gazebo>
    <plugin filename="ignition-gazebo-touchplugin-system" name="ignition::gazebo::systems::TouchPlugin">
      <!-- Substring of the touched collision's scoped name; every test box uses box_link. -->
      <target>box_link</target>
      <namespace>pac/suction</namespace>
      <time>0.1</time>
      <enabled>false</enabled>
    </plugin>
    <plugin filename="ignition-gazebo-detachable-joint-system" name="ignition::gazebo::systems::DetachableJoint">
      <parent_link>suction_cup_link</parent_link>
      <child_model>v43_scale_box_5kg</child_model>
      <child_link>box_link</child_link>
      <attach_topic>/pac/gripper/attach</attach_topic>
      <detach_topic>/pac/gripper/detach</detach_topic>
      <output_topic>/pac/gripper/state</output_topic>
      <suppress_child_warning>true</suppress_child_warning>
    </plugin>
  </gazebo>
</robot>
